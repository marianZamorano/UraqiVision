{
  "feature": "Alta de item",
  "fields": [
    { "name": "name", "type": "string", "minLength": 3, "maxLength": 10, "required": true },
    { "name": "capacity", "type": "integer", "min": 1, "max": 500 },
    { "name": "status", "type": "enum", "values": ["ACTIVE", "INACTIVE"] },
    { "name": "email", "type": "email", "required": true }
  ],
  "rules": [
    { "conditions": { "authenticated": false }, "outcome": "401" },
    { "conditions": { "authenticated": true, "role": "viewer" }, "outcome": "403" }
  ],
  "pairwise": true
}
