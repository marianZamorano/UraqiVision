{
  "name": "uraqivision-repo",
  "private": true,
  "description": "Herramientas del repositorio UraqiVision (validación de commits, sync de asistentes de IA). La web y el pipeline tienen sus propios paquetes.",
  "type": "module",
  "scripts": {
    "commitlint": "commitlint --edit",
    "pr:pendientes": "node ai/scripts/prs.mjs",
    "pr:estado": "node ai/scripts/prs.mjs estado",
    "pr:aprobar": "node ai/scripts/prs.mjs aprobar",
    "pr:fusionar": "node ai/scripts/prs.mjs fusionar",
    "commits:plan": "node ai/scripts/dividir-commits.mjs",
    "commits:dividir": "node ai/scripts/dividir-commits.mjs --aplicar",
    "ai:sync": "node ai/sync.mjs",
    "ai:check": "node ai/sync.mjs --check",
    "test:guardas": "node --test ai/hooks/test/guard.test.mjs ai/hooks/test/commit-groups.test.mjs ai/hooks/test/aprobaciones.test.mjs",
    "hooks:activar": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4"
  }
}
